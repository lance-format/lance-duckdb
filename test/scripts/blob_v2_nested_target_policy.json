{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::lance-test/nested_target.lance/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::lance-test"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["nested_target.lance/*"]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::lance-test/nested_target.lance/source/*"]
    }
  ]
}
