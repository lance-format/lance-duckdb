# name: test/sql/time_travel_at.test
# description: AT (VERSION | TIMESTAMP) reads an earlier version of an attached Lance table
# group: [sql]

require lance

statement ok
ATTACH '{TEST_DIR}' AS ns (TYPE LANCE);

# v1: 3 rows. v2: +1 row. v3: new column. v4: UPDATE. v5: DELETE. Each commit is
# followed by a timestamp taken after it and before the next one.
statement ok
CREATE OR REPLACE TABLE ns.main.tt AS
  SELECT i::BIGINT AS id, 'a' AS tag FROM range(3) r(i);

statement ok
SET VARIABLE after_v1 = (SELECT current_timestamp);

statement ok
INSERT INTO ns.main.tt VALUES (10, 'b');

statement ok
SET VARIABLE after_v2 = (SELECT current_timestamp);

statement ok
ALTER TABLE ns.main.tt ADD COLUMN extra INTEGER;

statement ok
UPDATE ns.main.tt SET tag = 'c' WHERE id = 0;

statement ok
DELETE FROM ns.main.tt WHERE id = 1;

# Latest is unchanged by the AT views.
query IIT
SELECT id, extra, tag FROM ns.main.tt ORDER BY id
----
0	NULL	c
2	NULL	a
10	NULL	b

query I
SELECT count(*) FROM ns.main.tt AT (VERSION => 1)
----
3

query IT
SELECT * FROM ns.main.tt AT (VERSION => 2) ORDER BY id
----
0	a
1	a
2	a
10	b

# The schema is the schema of that version.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM ns.main.tt AT (VERSION => 2))
----
id	BIGINT
tag	VARCHAR

query ITI
SELECT * FROM ns.main.tt AT (VERSION => 3) ORDER BY id
----
0	a	NULL
1	a	NULL
2	a	NULL
10	b	NULL

query IT
SELECT id, tag FROM ns.main.tt AT (VERSION => 4) ORDER BY id
----
0	c
1	a
2	a
10	b

# Pushed filters, projections, and aggregates read the AT version, not the latest.
query I
SELECT count(*) FROM ns.main.tt AT (VERSION => 1) WHERE id >= 1
----
2

query IRIT
SELECT sum(id), avg(id), max(id), min(tag) FROM ns.main.tt AT (VERSION => 2)
----
13	3.25	10	a

query TI
SELECT tag, count(*) FROM ns.main.tt AT (VERSION => 4) GROUP BY tag ORDER BY tag
----
a	2
b	1
c	1

# An old and the latest version in one statement.
query IT
SELECT o.id, o.tag || '>' || n.tag
FROM ns.main.tt o AT (VERSION => 3) JOIN ns.main.tt n USING (id)
WHERE o.tag <> n.tag OR o.id = 2 ORDER BY o.id
----
0	a>c
2	a>a

query I
SELECT count(*) FROM ns.main.tt o, ns.main.tt h AT (VERSION => 1) WHERE h.id = 1
----
3

# TIMESTAMP picks the newest version committed at or before it.
query I
SELECT count(*) FROM ns.main.tt AT (TIMESTAMP => getvariable('after_v1'))
----
3

query I
SELECT count(*) FROM ns.main.tt AT (TIMESTAMP => getvariable('after_v2'))
----
4

query I
SELECT count(*) FROM ns.main.tt AT (TIMESTAMP => current_timestamp)
----
3

query I
SELECT count(*) FROM ns.main.tt AT (TIMESTAMP => TIMESTAMP '2999-01-01')
----
3

# A version restores into the table that has since moved on.
statement ok
INSERT INTO ns.main.tt (id, tag) SELECT id, tag FROM ns.main.tt AT (VERSION => 1) WHERE id = 1;

query IT
SELECT id, tag FROM ns.main.tt WHERE id = 1
----
1	a

# A prepared statement keeps reading the AT version after later commits.
statement ok
PREPARE at_v1 AS SELECT count(*) FROM ns.main.tt AT (VERSION => 1) WHERE id > $1;

query I
EXECUTE at_v1(0)
----
2

statement ok
INSERT INTO ns.main.tt (id, tag) VALUES (100, 'z');

query I
EXECUTE at_v1(0)
----
2

# Errors.
statement error
SELECT * FROM ns.main.tt AT (VERSION => 99)
----
Failed to open version 99

statement error
SELECT * FROM ns.main.tt AT (VERSION => 0)
----
Lance table versions start at 1

statement error
SELECT * FROM ns.main.tt AT (VERSION => NULL)
----
requires a non-NULL value

statement error
SELECT * FROM ns.main.tt AT (TIMESTAMP => TIMESTAMP '2000-01-01')
----
has no version at or before

statement error
SELECT * FROM ns.main.missing AT (VERSION => 1)
----
Table with name missing does not exist

statement ok
DETACH ns;
