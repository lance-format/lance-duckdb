# name: test/sql/version_admin_branch_tag.test
# description: Tags that live on another Lance branch are not treated as snapshots of the opened branch.
# group: [sql]

# Fixture: test/data/branch_tag_fixture.lance, regenerate with
# test/scripts/gen_branch_tag_fixture.py (requires pylance + pyarrow).

require lance

# Main holds versions 1..3; the tag 'main_tag' is on main version 1 and
# 'dev_tag' is on the 'dev' branch, whose version number equals one of main's.
query TIT
SELECT tag, version, branch FROM lance_tags('test/data/branch_tag_fixture.lance') ORDER BY tag;
----
dev_tag	3	dev
main_tag	1	NULL

# Only the main-branch tag names a version of main.
query IT
SELECT version, tags FROM lance_versions('test/data/branch_tag_fixture.lance') ORDER BY version;
----
1	[main_tag]
2	[]
3	[]

# Restoring a branch tag is rejected instead of restoring main's version with the
# same number.
statement error
ALTER TABLE 'test/data/branch_tag_fixture.lance' RESTORE TO TAG dev_tag;
----
branch 'dev'

query I
SELECT id FROM 'test/data/branch_tag_fixture.lance';
----
3
