# name: test/sql/version_admin_branch_tag.test
# description: lance_tags and lance_versions on a dataset that holds tags on another Lance branch
# group: [sql]

# Fixture: test/data/branch_tag_fixture.lance, regenerate with
# test/scripts/gen_branch_tag_fixture.py (requires pylance + pyarrow).

require lance

# Main holds versions 1..3; the tag 'main_tag' is on main version 1 and
# 'dev_tag' is on the 'dev' branch, whose version number equals one of main's.
query TIT
SELECT tag, version, branch FROM lance_tags('test/data/branch_tag_fixture.lance') ORDER BY tag;
----
dev_tag	3	dev
main_tag	1	NULL

query TT
SELECT tag, created_at IS NOT NULL AND updated_at IS NOT NULL FROM lance_tags('test/data/branch_tag_fixture.lance') ORDER BY tag;
----
dev_tag	true
main_tag	true

# Only the main-branch tag names a version of main.
query IT
SELECT version, tags FROM lance_versions('test/data/branch_tag_fixture.lance') ORDER BY version;
----
1	[main_tag]
2	[]
3	[]

# An attached table resolves to the same dataset and lists the same tags.
statement ok
ATTACH 'test/data' AS vtag_ns (TYPE LANCE);

query TIT
SELECT tag, version, branch FROM lance_tags('vtag_ns.main.branch_tag_fixture') ORDER BY tag;
----
dev_tag	3	dev
main_tag	1	NULL

query IT
SELECT version, tags FROM lance_versions('vtag_ns.main.branch_tag_fixture') ORDER BY version;
----
1	[main_tag]
2	[]
3	[]
