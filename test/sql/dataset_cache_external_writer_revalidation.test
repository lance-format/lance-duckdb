# name: test/sql/dataset_cache_external_writer_revalidation.test
# description: Cache hits are revalidated against the latest committed version so external commits become visible
# group: [sql]

require lance

# The dataset cache is connection-local, so a commit made through con2 acts as
# an "external writer" from con1's perspective: the write invalidates only
# con2's own cache entry. Without revalidation on cache hit, con1 would keep
# serving the pre-commit version forever.

statement ok con1
COPY (
  SELECT 1::BIGINT AS id, 'a'::VARCHAR AS s
  UNION ALL
  SELECT 2::BIGINT AS id, 'b'::VARCHAR AS s
  UNION ALL
  SELECT 3::BIGINT AS id, 'c'::VARCHAR AS s
) TO '{TEST_DIR}/cache_external_writer.lance' (FORMAT lance, mode 'overwrite');

# con1 caches the dataset at the initial version.
query I con1
SELECT count(*) FROM '{TEST_DIR}/cache_external_writer.lance';
----
3

query II con1
EXPLAIN (FORMAT JSON) SELECT * FROM '{TEST_DIR}/cache_external_writer.lance';
----
physical_plan	<REGEX>:[\s\S]*"Lance Dataset Cache Hit": "true"[\s\S]*

# External delete: committed through con2, bypassing con1's connection.
statement ok con2
ATTACH '{TEST_DIR}' AS ext_writer_ns (TYPE LANCE);

query I con2
DELETE FROM ext_writer_ns.main.cache_external_writer WHERE id = 3;
----
1

# con1 must observe the externally committed delete on its next read.
query I con1
SELECT count(*) FROM '{TEST_DIR}/cache_external_writer.lance';
----
2

query I con1
SELECT id FROM '{TEST_DIR}/cache_external_writer.lance' ORDER BY id;
----
1
2

# External append: con2 commits a new row.
statement ok con2
COPY (SELECT 4::BIGINT AS id, 'd'::VARCHAR AS s)
TO '{TEST_DIR}/cache_external_writer.lance' (FORMAT lance, mode 'append');

# The first con1 access after the external commit refreshes the stale entry
# and reports it as a cache miss...
query II con1
EXPLAIN (FORMAT JSON) SELECT * FROM '{TEST_DIR}/cache_external_writer.lance';
----
physical_plan	<REGEX>:[\s\S]*"Lance Dataset Cache Hit": "false"[\s\S]*

# ...and sees the appended row.
query I con1
SELECT count(*) FROM '{TEST_DIR}/cache_external_writer.lance';
----
3

# Once refreshed, subsequent hits stay hits until the next external commit.
query II con1
EXPLAIN (FORMAT JSON) SELECT * FROM '{TEST_DIR}/cache_external_writer.lance';
----
physical_plan	<REGEX>:[\s\S]*"Lance Dataset Cache Hit": "true"[\s\S]*

# Catalog-attached reads go through the same cache and must also observe
# external commits.
statement ok con1
ATTACH '{TEST_DIR}' AS ext_reader_ns (TYPE LANCE);

query I con1
SELECT count(*) FROM ext_reader_ns.main.cache_external_writer;
----
3

query I con2
DELETE FROM ext_writer_ns.main.cache_external_writer WHERE id = 1;
----
1

query I con1
SELECT count(*) FROM ext_reader_ns.main.cache_external_writer;
----
2

# External drop + re-create at the same URI: the new table's history restarts
# at the same version id as the cached entry (both are at version 1), so only
# the manifest identity (e-tag) distinguishes the two tables. The cached
# reader must observe the re-created table, not the dropped one.
statement ok con1
COPY (
  SELECT 1::BIGINT AS id, 'a'::VARCHAR AS s
  UNION ALL
  SELECT 2::BIGINT AS id, 'b'::VARCHAR AS s
  UNION ALL
  SELECT 3::BIGINT AS id, 'c'::VARCHAR AS s
) TO '{TEST_DIR}/cache_recreate.lance' (FORMAT lance, mode 'overwrite');

# con1 caches the dataset at version 1 of the original table.
query I con1
SELECT count(*) FROM '{TEST_DIR}/cache_recreate.lance';
----
3

query I con1
SELECT sum(id) FROM ext_reader_ns.main.cache_recreate;
----
6

statement ok con2
DROP TABLE ext_writer_ns.main.cache_recreate;

statement error con1
SELECT * FROM ext_reader_ns.main.cache_recreate AT (VERSION => 1);
----
Table with name cache_recreate does not exist

statement ok con2
COPY (
  SELECT 10::BIGINT AS id, 'x'::VARCHAR AS s
  UNION ALL
  SELECT 20::BIGINT AS id, 'y'::VARCHAR AS s
) TO '{TEST_DIR}/cache_recreate.lance' (FORMAT lance, mode 'overwrite');

# The re-created table is also at version 1; con1 must still see it.
query I con1
SELECT count(*) FROM '{TEST_DIR}/cache_recreate.lance';
----
2

query I con1
SELECT id FROM '{TEST_DIR}/cache_recreate.lance' ORDER BY id;
----
10
20

# The warm catalog name resolves v1 from the replacement dataset.
query I con1
SELECT sum(id) FROM ext_reader_ns.main.cache_recreate AT (VERSION => 1);
----
30

# A case-sensitive store can replace the discovered name with another spelling.
statement ok con1
ATTACH 'shared-memory://recreated-version/root' AS case_reader (TYPE LANCE);

statement ok con2
ATTACH 'shared-memory://recreated-version/root' AS case_writer (TYPE LANCE);

statement ok con2
CREATE TABLE case_writer.main.Sales AS SELECT 1 AS old_id;

query I con1
SELECT old_id FROM case_reader.main.sales;
----
1

statement ok con2
DROP TABLE case_writer.main.Sales;

statement ok con2
CREATE TABLE case_writer.main.sales AS SELECT 42 AS new_id;

query I con1
SELECT new_id FROM case_reader.main.SALES AT (VERSION => 1);
----
42

# Each warm attachment has an exact spelling. A fresh attachment must detect
# the ambiguity even when the statement has already bound a warm attachment.
statement ok con1
ATTACH 'shared-memory://recreated-version/root' AS case_second (TYPE LANCE);

statement ok con1
ATTACH 'shared-memory://recreated-version/root' AS case_cold (TYPE LANCE);

statement error con1
SELECT * FROM case_cold.main.missing AT (VERSION => 0);
----
Table with name missing does not exist

statement ok con2
COPY (SELECT 11 AS id) TO 'shared-memory://recreated-version/root/Foo.lance' (FORMAT lance);

query I con1
SELECT id FROM case_reader.main.foo;
----
11

statement ok con2
DROP TABLE case_writer.main.Foo;

statement ok con2
COPY (SELECT 22 AS id) TO 'shared-memory://recreated-version/root/foo.lance' (FORMAT lance);

query I con1
SELECT id FROM case_second.main.foo;
----
22

statement ok con2
COPY (SELECT 11 AS id) TO 'shared-memory://recreated-version/root/Foo.lance' (FORMAT lance);

query II con1
SELECT a.id,b.id FROM case_reader.main.foo a AT (VERSION => 1), case_second.main.foo b AT (VERSION => 1);
----
11	22

query II con1
SELECT b.id,a.id FROM case_second.main.foo b AT (VERSION => 1), case_reader.main.foo a AT (VERSION => 1);
----
22	11

statement error con1
SELECT * FROM case_reader.main.foo a AT (VERSION => 1), case_cold.main.foo b AT (VERSION => 1);
----
Ambiguous Lance directory table names

statement error con1
SELECT * FROM case_cold.main.foo a AT (VERSION => 1), case_second.main.foo b AT (VERSION => 1);
----
Ambiguous Lance directory table names

statement error con1
SELECT * FROM case_cold.main.foo AT (VERSION => 0);
----
Ambiguous Lance directory table names

statement ok con1
DETACH ext_reader_ns;

statement ok con2
DETACH ext_writer_ns;
