statement error
CREATE TABLE ns.s1.ctas_t AS SELECT 1::BIGINT AS id;
----
Catalog Error: Schema with name s1 does not exist!

statement ok
CREATE TABLE ns.main.main_t AS SELECT 1::BIGINT AS id;

query I
