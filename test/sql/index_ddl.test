statement ok
COPY (
  SELECT 1::BIGINT AS id, 'document one'::VARCHAR AS text
  UNION ALL
  SELECT 2::BIGINT AS id, 'document two'::VARCHAR AS text
  UNION ALL
  SELECT 3::BIGINT AS id, 'other text'::VARCHAR AS text
) TO '{TEST_DIR}/index_ddl_text.lance' (FORMAT lance, mode 'overwrite');

# Scalar index options reach Lance in lower case, so Lance validates this
# tokenizer instead of ignoring an option name it does not know.
statement error
CREATE INDEX bad_tokenizer_idx ON '{TEST_DIR}/index_ddl_text.lance' (text)
USING INVERTED WITH (Base_Tokenizer='no_such_tokenizer');
----
unknown base tokenizer no_such_tokenizer

statement ok
CREATE INDEX text_idx ON '{TEST_DIR}/index_ddl_text.lance' (text)
USING INVERTED;

query I
SELECT count(*)
FROM lance_fts('{TEST_DIR}/index_ddl_text.lance', 'text', 'document', k = 10);
----
2

query TTTIT
SHOW INDEXES ON '{TEST_DIR}/index_ddl_text.lance';
----
text_idx	<REGEX>:.*	text	3	<REGEX>:.*

statement ok
DROP INDEX text_idx ON '{TEST_DIR}/index_ddl_text.lance';

query TTTIT
SHOW INDEXES ON '{TEST_DIR}/index_ddl_text.lance';
