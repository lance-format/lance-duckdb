  'vec',
  [
    0.32245764,
    0.2814153,
    0.08346437,
    0.28065863,
    0.2566661,
    -0.47035545,
    -0.9935358,
    0.09578487,
    0.000604047,
    -0.37332273,
    0.12592472,
    -0.3458825,
    -0.2536356,
    -0.3673502,
    -0.68120277,
    0.41665298
  ]::FLOAT[16],
  k = 1,
  nprobs = 2,
  refine_factor = 3,
  use_index = true,
  explain_verbose = true
);
