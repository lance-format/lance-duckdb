# Vector search over ARRAY vectors written by DuckDB (preferred usage)
statement ok
COPY (
  SELECT *
  FROM (
    VALUES
      (1::BIGINT, 'duck'::VARCHAR, [0.9, 0.7, 0.1]::FLOAT[3]),
      (2::BIGINT, 'horse'::VARCHAR, [0.3, 0.1, 0.5]::FLOAT[3]),
      (3::BIGINT, 'dragon'::VARCHAR, [0.5, 0.2, 0.7]::FLOAT[3])
  ) AS t(id, animal, vec)
) TO '{TEST_DIR}/knn_array_f32.lance' (FORMAT lance, mode 'overwrite');

query I
SELECT id
FROM lance_vector_search(
  '{TEST_DIR}/knn_array_f32.lance',
  'vec',
  [0.8, 0.7, 0.2]::FLOAT[3],
  k = 1,
  use_index = false
)
ORDER BY _distance;
----
1

statement ok
