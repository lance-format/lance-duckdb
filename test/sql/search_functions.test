# ===================================================================
# Table name resolution: search functions support catalog table names
# (Users can ATTACH a Lance directory and use table names instead of
#  file paths in lance_fts / lance_vector_search / lance_hybrid_search)
# ===================================================================

# Setup: attach a Lance directory as a namespace
statement ok
ATTACH 'test/data' AS search_ns (TYPE LANCE);

statement ok
use search_ns;

# FTS search using fully qualified catalog table name (catalog.schema.table)
query I
SELECT count(*) FROM lance_fts('search_ns.main.search_test_data', 'text', 'puppy', k = 10)
----
2

# FTS search using simple table name
query I
SELECT count(*) FROM lance_fts('search_test_data', 'text', 'puppy', k = 10)
----
2

# FTS namespace query_table filter
query I
SELECT id
FROM lance_fts(
  'search_ns.main.search_test_data',
  'text',
  'puppy',
  k = 10,
  filter = 'label >= 3'
)
ORDER BY id
----
3

# FTS namespace query_table prefilter with a pushed WHERE clause
query I
SELECT id
FROM lance_fts(
  'search_ns.main.search_test_data',
  'text',
  'puppy',
  k = 10,
  prefilter = true
)
WHERE label >= 3
ORDER BY id
----
3

# FTS namespace query_table prefilter with explicit filter
query I
SELECT id
FROM lance_fts(
  'search_ns.main.search_test_data',
  'text',
  'puppy',
  k = 10,
  prefilter = true,
  filter = 'label >= 3'
)
ORDER BY id
----
3

# Vector search using fully qualified catalog table name
query I
SELECT id
FROM lance_vector_search(
  'search_ns.main.search_test_data',
  'vec',
  [0.0, 0.0, 0.0, 0.0]::FLOAT[4],
  k = 3,
  use_index = false
)
ORDER BY _distance
----
1
2
3

