# Vector search over LIST vectors written by DuckDB is supported via writer normalization (issue #117)
statement ok
COPY (
  SELECT *
  FROM (
    VALUES
      (1::BIGINT, 'duck'::VARCHAR, [0.9, 0.7, 0.1]::FLOAT[]),
      (2::BIGINT, 'horse'::VARCHAR, [0.3, 0.1, 0.5]::FLOAT[]),
      (3::BIGINT, 'dragon'::VARCHAR, [0.5, 0.2, 0.7]::FLOAT[])
  ) AS t(id, animal, vec)
) TO '{TEST_DIR}/knn_list_f32.lance' (FORMAT lance, mode 'overwrite');

query I
SELECT id
FROM lance_vector_search(
