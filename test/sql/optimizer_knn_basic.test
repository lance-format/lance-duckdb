statement ok
SET lance_knn_nprobes = 32;

query II
EXPLAIN (FORMAT JSON)
SELECT id
FROM 'test/.tmp/knn_opt_l2.lance'
ORDER BY array_distance(vec, [
  0.32245764, 0.2814153, 0.08346437, 0.28065863,
