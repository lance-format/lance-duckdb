# name: test/sql/secret_external_access.test
# description: Lance secrets follow DuckDB's secret storage rules when external access is disabled
# group: [sql]

require lance

statement ok
SET secret_directory='{TEST_DIR}/secret_external_access';

# Create a secret while external access is still enabled.
statement ok
CREATE SECRET lance_before_disable (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);

statement ok
SET enable_external_access=false;

# DuckDB allows in-memory secret creation without external access. The Lance
# config provider only copies the supplied options into the secret, so creating
# one has no external side effect.
statement ok
CREATE SECRET lance_after_disable (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);

statement ok
CREATE SECRET lance_connection_after_disable IN connection (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);

# Persistent secrets still need the local file system, which the setting
# disables.
statement error
CREATE PERSISTENT SECRET lance_persistent_after_disable (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);
----
file system operations are disabled by configuration

# Disabling external access does not invalidate secrets that already exist, and
# the in-memory secrets created above remain available.
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'lance_before_disable';
----
1

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name IN ('lance_after_disable', 'lance_connection_after_disable');
----
2

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'lance_persistent_after_disable';
----
0
