# name: test/sql/secret_external_access.test
# description: Lance secret creation honours DuckDB's external access setting
# group: [sql]

require lance

# Registering the lance secret type must not bypass DuckDB's gate: creating a
# secret reaches outside the database, so it is refused while external access is
# disabled.
statement ok
CREATE SECRET lance_before_disable (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);

statement ok
SET enable_external_access=false;

statement error
CREATE SECRET lance_after_disable (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);
----
Creating secrets is disabled when enable_external_access is false

statement error
CREATE SECRET lance_connection_after_disable IN connection (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://lance-external-access/',
  ACCESS_KEY_ID 'id',
  SECRET_ACCESS_KEY 'key',
  REGION 'us-east-1'
);
----
Creating secrets is disabled when enable_external_access is false

# Disabling external access does not invalidate secrets that already exist.
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'lance_before_disable';
----
1
