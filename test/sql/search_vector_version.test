# name: test/sql/search_vector_version.test
# description: Historical vector search uses one snapshot for schema, index, distances and rows
# group: [sql]

require lance

statement ok
COPY (SELECT 11 + i AS id, [1 + i, 0]::FLOAT[2] AS vec, 'old' AS label FROM range(128) t(i))
TO '{TEST_DIR}/items.lance' (FORMAT lance);

statement ok
CREATE INDEX old_vec_idx ON '{TEST_DIR}/items.lance' (vec)
USING IVF_FLAT WITH (num_partitions = 1, metric_type = 'l2');

statement ok
ATTACH '{TEST_DIR}' AS ns (TYPE LANCE);

statement ok
PREPARE latest_by_name AS SELECT id
FROM lance_vector_search('ns.main.items', 'vec', [0, 0]::FLOAT[2], k = 1);

query I
EXECUTE latest_by_name;
----
11

statement ok
PREPARE latest AS SELECT id FROM lance_vector_search('{TEST_DIR}/items.lance', 'vec', [0, 0]::FLOAT[2], k = 1);

query I
EXECUTE latest;
----
11

# Capture the result while the indexed snapshot is still current.
statement ok
CREATE TEMP TABLE expected AS SELECT id, label, _rowid AS rid, _distance AS dist
FROM lance_vector_search('{TEST_DIR}/items.lance', 'vec', [0, 0]::FLOAT[2], k = 1);

statement ok
COPY (SELECT 91 AS id, [0, 0]::FLOAT[2] AS vec)
TO '{TEST_DIR}/items.lance' (FORMAT lance, mode 'overwrite');

query I
EXECUTE latest;
----
91

query ITII
SELECT id, label, _rowid, _distance FROM lance_vector_search(
    '{TEST_DIR}/items.lance', 'vec', [0, 0]::DOUBLE[], version = 1, k = 1, use_index = false);
----
11	old	0	1

query I
SELECT count(*) FROM lance_vector_search(
    '{TEST_DIR}/items.lance', 'vec', [0, 0]::FLOAT[2], version = 2, k = 1) h
JOIN expected e ON (h.id, h.label, h._rowid, h._distance) = (e.id, e.label, e.rid, e.dist);
----
1

query TT
EXPLAIN (FORMAT JSON) SELECT id FROM lance_vector_search(
    '{TEST_DIR}/items.lance', 'vec', [0, 0]::FLOAT[2], version = 2, k = 1, explain_verbose = true);
----
physical_plan	<REGEX>:[\s\S]*ANNSubIndex: name=old_vec_idx[\s\S]*

statement ok
PREPARE replay AS SELECT id FROM lance_vector_search(
    '{TEST_DIR}/items.lance', 'vec', [0, 0]::FLOAT[2], version = $1, k = 1);

query I
EXECUTE replay(2::BIGNUM);
----
11

query I
EXECUTE replay(3);
----
91

statement error
EXECUTE replay(NULL);
----
requires a non-NULL value

statement error
EXECUTE replay(0);
----
Lance table versions start at 1

statement error
EXECUTE replay(1.5);
----
requires an integer value

statement error
EXECUTE replay(true);
----
Search version requires a positive integer

statement error
EXECUTE replay(99);
----
Failed to open version 99

query I
EXECUTE latest_by_name;
----
91

# The live schema no longer has the column used by the historical index.
statement ok
COPY (SELECT 91 AS id, [0, 0]::FLOAT[2] AS replacement_vec)
TO '{TEST_DIR}/items.lance' (FORMAT lance, mode 'overwrite');

statement ok
ATTACH '{TEST_DIR}' AS replay (TYPE lance, DEFAULT_TABLE 'items');

query I
SELECT count(*) FROM lance_vector_search('replay', 'vec', [0,0]::FLOAT[2], version = 2, k = 1) h
JOIN replay t AT (VERSION => 2) ON (h.id, h._rowid) = (t.id, t.rowid)
JOIN expected e ON (h.id, h.label, h._rowid, h._distance) = (e.id, e.label, e.rid, e.dist);
----
1

query I
SELECT count(*) FROM lance_vector_search(
    'ns.main.Items', 'VeC', [0, 0]::FLOAT[2], version = 2, k = 1) h
JOIN lance_vector_search('{TEST_DIR}/items.lance', 'vec', [0, 0]::FLOAT[2], version = 2, k = 1) p
    ON (p.id, p.label, p._rowid, p._distance) = (h.id, h.label, h._rowid, h._distance)
JOIN expected e ON (h.id, h.label, h._rowid, h._distance) = (e.id, e.label, e.rid, e.dist)
JOIN ns.main.items t AT (VERSION => 2) ON t.rowid = h._rowid AND t.id = h.id;
----
1

query TT
EXPLAIN (FORMAT JSON) SELECT id FROM lance_vector_search(
    'ns.main.items', 'vec', [0, 0]::FLOAT[2], version = 2, k = 1, explain_verbose = true);
----
physical_plan	<REGEX>:[\s\S]*ANNSubIndex: name=old_vec_idx[\s\S]*

query I
SELECT id FROM lance_vector_search('ns.main.items', 'vec', [0, 0]::FLOAT[2],
    version = 1, k = 1, prefilter = true, filter = 'id >= 12') WHERE id < 15;
----
12

# Appending keeps id 11 addressable at both versions, but makes id 91 the live nearest neighbor.
statement ok
CREATE TABLE ns.main.delete_candidates AS SELECT 11 AS id, [1,0]::FLOAT[2] AS vec;

statement ok
INSERT INTO ns.main.delete_candidates VALUES (91, [0,0]::FLOAT[2]);

statement ok
DELETE FROM ns.main.delete_candidates WHERE rowid IN (
    SELECT _rowid FROM lance_vector_search('ns.main.delete_candidates', 'vec', [0,0]::FLOAT[2], version = 1, k = 1));

query I
SELECT id FROM ns.main.delete_candidates;
----
91

statement ok
VACUUM LANCE ns.main.items WITH (retain_n_versions = 1);

statement error
EXECUTE replay(2);
----
Failed to open version 2

statement error
SELECT id FROM lance_vector_search('ns.main.items', 'vec', [0, 0]::FLOAT[2], version = 2, k = 1);
----
Failed to open version 2

query I
SELECT id FROM lance_vector_search('ns.main.items', 'replacement_vec', [0, 0]::FLOAT[2], k = 1);
----
91
