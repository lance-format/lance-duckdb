# name: test/sql/search_runtime_filters.test
# description: Join runtime filters filter search results after top-k instead of changing the ranking
# group: [sql]

require lance

statement ok
SET threads = 1;

statement ok
CREATE OR REPLACE TABLE search_runtime_probe AS
SELECT i::BIGINT AS id, i::BIGINT AS key2, i::INTEGER AS label,
       'puppy doc ' || (i % 5)::VARCHAR AS text,
       [i::FLOAT, 1.0]::FLOAT[2] AS vec
FROM range(100) t(i);

statement ok
COPY search_runtime_probe
TO '{TEST_DIR}/search_runtime_probe.lance' (FORMAT lance, mode 'overwrite');

statement ok
COPY (
  SELECT * FROM (VALUES (80::BIGINT, 80::BIGINT), (90::BIGINT, 90::BIGINT)) t(id, key2)
) TO '{TEST_DIR}/search_runtime_allowed.lance' (FORMAT lance, mode 'overwrite');

# The bare vector and hybrid searches rank 50, 49, 51; FTS ranks 0, 1, 2.
# Every one of those rows is outside the join's build range, so a correct
# post-top-k join returns nothing.
query I
SELECT id
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3, use_index = false)
ORDER BY _distance, id;
----
50
49
51

query I
SELECT id
FROM lance_fts('{TEST_DIR}/search_runtime_probe.lance', 'text', 'puppy', k = 3)
ORDER BY id;
----
0
1
2

query I
SELECT id
FROM lance_hybrid_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], 'text', 'puppy',
                         k = 3, use_index = false)
ORDER BY _hybrid_score DESC, id;
----
50
49
51

# The same data and join do match when the search is not involved, and the
# plain scan keeps its runtime filter pushdown.
query I
SELECT count(*)
FROM '{TEST_DIR}/search_runtime_probe.lance' p
JOIN '{TEST_DIR}/search_runtime_allowed.lance' a
  ON p.id = a.id AND p.key2 = a.key2;
----
2

query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT count(*)
FROM '{TEST_DIR}/search_runtime_probe.lance' p
JOIN '{TEST_DIR}/search_runtime_allowed.lance' a
  ON p.id = a.id AND p.key2 = a.key2;
----
analyzed_plan	<REGEX>:[\s\S]*"Lance Filter IR Bytes": "[1-9][0-9]*"[\s\S]*

# Without runtime join filters the searches already return nothing here.
statement ok
SET disabled_optimizers = 'join_filter_pushdown';

query I
SELECT count(*)
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = true, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

query I
SELECT count(*)
FROM lance_fts('{TEST_DIR}/search_runtime_probe.lance', 'text', 'puppy',
               k = 3, prefilter = true) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

query I
SELECT count(*)
FROM lance_hybrid_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], 'text', 'puppy',
                         k = 3, prefilter = true, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

statement ok
RESET disabled_optimizers;

# Enabling runtime filters must not promote rows that the build side still
# rejects. The multi-key join emits an optional IN hint plus required min/max
# ranges; both belong after the search's top-k.
query I
SELECT count(*)
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = true, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

query I
SELECT count(*)
FROM lance_fts('{TEST_DIR}/search_runtime_probe.lance', 'text', 'puppy',
               k = 3, prefilter = true) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

query I
SELECT count(*)
FROM lance_hybrid_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], 'text', 'puppy',
                         k = 3, prefilter = true, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

# prefilter = false keeps the same post-top-k result.
query I
SELECT count(*)
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = false, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

# A SQL range still prefilters while the runtime range does not: `label` is
# only a filter column and is not part of the search output.
query I
SELECT count(*)
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = true, use_index = false) s
WHERE s.label >= 40
  AND EXISTS (
    SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
    WHERE s.id = a.id AND s.key2 = a.key2
  );
----
0

query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT s.id
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = true, use_index = false) s
WHERE s.label >= 40
  AND EXISTS (
    SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
    WHERE s.id = a.id AND s.key2 = a.key2
  );
----
analyzed_plan	<REGEX>:[\s\S]*"Lance Plan": \[[\s\S]*FilterExec: label@0 >= 40[\s\S]*

query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT s.id
FROM lance_vector_search('{TEST_DIR}/search_runtime_probe.lance', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = true, use_index = false) s
WHERE s.label >= 40
  AND EXISTS (
    SELECT 1 FROM '{TEST_DIR}/search_runtime_allowed.lance' a
    WHERE s.id = a.id AND s.key2 = a.key2
  );
----
analyzed_plan	<!REGEX>:[\s\S]*id@0 >= 80[\s\S]*

# Attached tables take the same path as dataset paths.
statement ok
COPY search_runtime_probe
TO '{TEST_DIR}/search_runtime_ns/probe.lance' (FORMAT lance, mode 'overwrite');

statement ok
COPY (
  SELECT * FROM (VALUES (80::BIGINT, 80::BIGINT), (90::BIGINT, 90::BIGINT)) t(id, key2)
) TO '{TEST_DIR}/search_runtime_ns/allowed.lance' (FORMAT lance, mode 'overwrite');

statement ok
ATTACH '{TEST_DIR}/search_runtime_ns' AS search_runtime_ns (TYPE LANCE);

query I
SELECT count(*)
FROM lance_vector_search('search_runtime_ns.main.probe', 'vec',
                         [50.0, 1.0]::FLOAT[2], k = 3,
                         prefilter = true, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM search_runtime_ns.main.allowed a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

query I
SELECT count(*)
FROM lance_fts('search_runtime_ns.main.probe', 'text', 'puppy',
               k = 3, prefilter = true) s
WHERE EXISTS (
  SELECT 1 FROM search_runtime_ns.main.allowed a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

query I
SELECT count(*)
FROM lance_hybrid_search('search_runtime_ns.main.probe', 'vec',
                         [50.0, 1.0]::FLOAT[2], 'text', 'puppy',
                         k = 3, prefilter = true, use_index = false) s
WHERE EXISTS (
  SELECT 1 FROM search_runtime_ns.main.allowed a
  WHERE s.id = a.id AND s.key2 = a.key2
);
----
0

statement ok
DETACH search_runtime_ns;
