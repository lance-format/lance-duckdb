# name: test/sql/catalog_checkpoint.test
# description: Checkpoints preserve extension-owned tables in an attached Lance catalog
# group: [sql]

require lance

statement ok
ATTACH '{TEST_DIR}/checkpoint_namespace' AS checkpoint_ns (TYPE LANCE);

statement ok
CREATE OR REPLACE TABLE checkpoint_ns.main.items AS SELECT 1::BIGINT AS id;

statement ok
FORCE CHECKPOINT checkpoint_ns;

query I
SELECT id FROM checkpoint_ns.main.items
----
1

statement ok
INSERT INTO checkpoint_ns.main.items VALUES (2);

statement ok
CHECKPOINT checkpoint_ns;

query I
SELECT sum(id) FROM checkpoint_ns.main.items
----
3

statement ok
DETACH checkpoint_ns;

# Refresh external metadata inside an explicit transaction, then roll back.
# Refreshing the cache must not enter native table commit/checkpoint machinery.
statement ok reader
SET checkpoint_threshold='1 B';

statement ok reader
ATTACH '{TEST_DIR}/checkpoint_namespace' AS checkpoint_reader (TYPE LANCE);

statement ok writer
ATTACH '{TEST_DIR}/checkpoint_namespace' AS checkpoint_writer (TYPE LANCE);

statement ok reader
PREPARE checkpoint_read AS SELECT sum(id) FROM checkpoint_reader.items;

statement ok writer
ALTER TABLE checkpoint_writer.items ADD COLUMN extra BIGINT DEFAULT 7;

statement ok reader
BEGIN;

query I reader
SELECT sum(extra) FROM checkpoint_reader.items;
----
14

statement ok reader
ROLLBACK;

query I reader
EXECUTE checkpoint_read;
----
3

statement ok reader
FORCE CHECKPOINT checkpoint_reader;

# DuckDB-owned views remain visible alongside Lance-owned table metadata.
statement ok reader
CREATE VIEW checkpoint_reader.ids AS SELECT id FROM checkpoint_reader.items;

query I reader
SELECT sum(id) FROM checkpoint_reader.ids;
----
3

statement ok reader
CHECKPOINT checkpoint_reader;

statement error reader
CREATE OR REPLACE VIEW checkpoint_reader.items AS SELECT 99 AS id;
----
Cannot replace a Lance table with a view

statement ok reader
CREATE VIEW IF NOT EXISTS checkpoint_reader.items AS SELECT 99 AS id;

query I reader
SELECT sum(id) FROM checkpoint_reader.items;
----
3

statement ok reader
DROP VIEW checkpoint_reader.ids;

statement ok reader
DETACH checkpoint_reader;

statement ok writer
DETACH checkpoint_writer;
