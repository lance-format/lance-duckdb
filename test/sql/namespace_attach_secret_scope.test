# name: test/sql/namespace_attach_secret_scope.test
# description: Directory namespace ATTACH matches trailing-slash secret scopes (#221).
# group: [sql]

require lance

# A directory namespace root is itself a URI prefix. A secret may scope that
# prefix with a trailing slash while ATTACH receives the root without one.
# The endpoint is intentionally unreachable: reaching it proves that the
# directory root matched the configured secret instead of falling back to AWS.
statement ok
CREATE SECRET directory_prefix_secret (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://example-bucket/ns_root/',
  ACCESS_KEY_ID 'test',
  SECRET_ACCESS_KEY 'test',
  REGION 'us-east-1',
  ENDPOINT 'http://127.0.0.1:1',
  VIRTUAL_HOSTED_STYLE_REQUEST false,
  ALLOW_HTTP true,
  CLIENT_MAX_RETRIES '0'
);

statement error
ATTACH 's3://example-bucket/ns_root' AS prefix_scope_ns (TYPE LANCE);
----
<REGEX>:.*127\.0\.0\.1:1.*

# The same applies to a bucket root: SCOPE 's3://bucket/' must match ATTACH
# 's3://bucket'.
statement ok
CREATE SECRET directory_bucket_secret (
  TYPE LANCE,
  PROVIDER config,
  SCOPE 's3://example-bucket-2/',
  ACCESS_KEY_ID 'test',
  SECRET_ACCESS_KEY 'test',
  REGION 'us-east-1',
  ENDPOINT 'http://127.0.0.1:1',
  VIRTUAL_HOSTED_STYLE_REQUEST false,
  ALLOW_HTTP true,
  CLIENT_MAX_RETRIES '0'
);

statement error
ATTACH 's3://example-bucket-2' AS bucket_scope_ns (TYPE LANCE);
----
<REGEX>:.*127\.0\.0\.1:1.*
