# name: test/sql/dml_alter_table_vector_schema_evolution.test
# description: ALTER TABLE can cast list vectors to fixed-size arrays for vector indexing
# group: [sql]

require lance

# Copy the fixture byte-for-byte into this test's private directory. A Lance
# SQL round trip would normalize its Arrow types and erase the condition under test.
statement ok
COPY (SELECT NULL::BLOB WHERE false)
TO '{TEST_DIR}/issue184_list_float.lance' (FORMAT BLOB, PER_THREAD_OUTPUT true);

foreach directory _versions _transactions data

statement ok
COPY (SELECT NULL::BLOB WHERE false)
TO '{TEST_DIR}/issue184_list_float.lance/{directory}' (FORMAT BLOB, PER_THREAD_OUTPUT true);

endloop

foreach file _transactions/0-5ae7ab90-86eb-4792-8161-2dc1d5f6abfc.txn _versions/18446744073709551614.manifest data/1101011010010010100101009ee8ad4ae5acb77d1a99811fb8.lance

statement ok
COPY (SELECT content FROM read_blob('test/data/issue184_list_float.lance/{file}'))
TO '{TEST_DIR}/issue184_list_float.lance/{file}' (FORMAT BLOB);

endloop

statement ok
ATTACH '{TEST_DIR}' AS ns (TYPE LANCE);

query T
SELECT typeof(embedding) FROM ns.main.issue184_list_float LIMIT 1;
----
FLOAT[]

statement ok
ALTER TABLE ns.main.issue184_list_float ALTER COLUMN embedding TYPE FLOAT[3];

query T
SELECT typeof(embedding) FROM ns.main.issue184_list_float LIMIT 1;
----
FLOAT[3]

statement ok
CREATE INDEX issue184_embedding_idx
ON ns.main.issue184_list_float (embedding)
USING IVF_FLAT WITH (num_partitions=1, metric_type='cosine');

query TTTIT
SHOW INDEXES ON ns.main.issue184_list_float;
----
issue184_embedding_idx	<REGEX>:.*	embedding	<REGEX>:[0-9]+	<REGEX>:.*

query I
SELECT id
FROM lance_vector_search(
  'ns.main.issue184_list_float',
  'embedding',
  [0.1, 0.2, 0.31]::FLOAT[3],
  k = 1,
  use_index = true
)
ORDER BY _distance, id;
----
1

statement ok
DETACH ns;
