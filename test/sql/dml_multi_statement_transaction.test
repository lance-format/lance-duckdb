# ---- one write per table in different tables is unaffected ----

statement ok
COPY (SELECT i::BIGINT AS id, i::BIGINT AS v FROM range(1, 11) r(i)) TO '{TEST_DIR}/tx_plain.lance' (FORMAT lance, mode 'overwrite');

statement ok
COPY (SELECT i::BIGINT AS id, i::BIGINT AS v FROM range(1, 11) r(i)) TO '{TEST_DIR}/tx_stable.lance' (FORMAT lance, mode 'overwrite', enable_stable_row_ids true);

statement ok
BEGIN TRANSACTION;

statement ok
UPDATE txg.main.tx_plain SET v = -1 WHERE id = 1;

statement ok
UPDATE txg.main.tx_stable SET v = -1 WHERE id = 1;

statement ok
COMMIT;

