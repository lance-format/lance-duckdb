# name: test/sql/dml_returning_blob.test
# description: DML RETURNING exposes BLOB bytes and does not read unreferenced external payloads
# group: [sql]

require lance

statement ok
ATTACH '{TEST_DIR}' AS ns (TYPE LANCE);

statement ok
CREATE TABLE ns.main.returning_blob (id BIGINT, label VARCHAR, payload BLOB);

query IT
INSERT INTO ns.main.returning_blob VALUES (1, 'old', 'hello'::BLOB)
RETURNING id, hex(payload);
----
1	68656C6C6F

query IT
UPDATE ns.main.returning_blob SET label = 'new' WHERE id = 1
RETURNING id, hex(payload);
----
1	68656C6C6F

query TIT
UPDATE ns.main.returning_blob SET payload = 'world'::BLOB WHERE id = 1
RETURNING label, id, hex(payload);
----
new	1	776F726C64

query IT
DELETE FROM ns.main.returning_blob WHERE id = 1 RETURNING id, hex(payload);
----
1	776F726C64

# Storing a reference does not read its source. An unrelated RETURNING field
# must not change that contract for INSERT, UPDATE or DELETE.
query I
INSERT INTO ns.main.returning_blob VALUES
(2, 'missing', lance_blob_ref('file://{TEMP_DIR_ABSOLUTE}/lance_returning_missing.bin'))
RETURNING id;
----
2

query I
UPDATE ns.main.returning_blob SET label = 'still-missing' WHERE id = 2 RETURNING id;
----
2

query I
UPDATE ns.main.returning_blob
SET payload = lance_blob_ref('file://{TEMP_DIR_ABSOLUTE}/lance_returning_missing.bin')
WHERE id = 2 RETURNING id;
----
2

statement error
UPDATE ns.main.returning_blob SET label = 'must-rollback' WHERE id = 2 RETURNING payload;
----
IO Error

query T
SELECT label FROM ns.main.returning_blob WHERE id = 2;
----
still-missing

statement error
DELETE FROM ns.main.returning_blob WHERE id = 2 RETURNING payload;
----
IO Error

query I
SELECT count(*) FROM ns.main.returning_blob WHERE id = 2;
----
1

query I
DELETE FROM ns.main.returning_blob WHERE id = 2 RETURNING id;
----
2

statement error
INSERT INTO ns.main.returning_blob VALUES
(3, 'bad', lance_blob_ref('file://{TEMP_DIR_ABSOLUTE}/lance_returning_missing.bin'))
RETURNING payload;
----
IO Error

query I
SELECT count(*) FROM ns.main.returning_blob;
----
0

# The predicate still consumes its target payload even when it is not returned.
statement ok
INSERT INTO ns.main.returning_blob VALUES
(4, 'match', 'selected'::BLOB), (5, 'keep', 'other'::BLOB), (6, 'null', NULL);

query I
DELETE FROM ns.main.returning_blob WHERE payload = 'selected'::BLOB RETURNING id;
----
4

query II
UPDATE ns.main.returning_blob SET label = 'null-checked' WHERE id = 6
RETURNING id, payload IS NULL;
----
6	true

# Self-join aliases must not confuse the target scan with the USING scan.
query IT
DELETE FROM ns.main.returning_blob AS t USING ns.main.returning_blob AS s
WHERE t.id = s.id AND s.payload = 'other'::BLOB
RETURNING t.id, hex(t.payload);
----
5	6F74686572

query II
DELETE FROM ns.main.returning_blob RETURNING id, payload IS NULL;
----
6	true

statement ok
COPY (SELECT 'ingested'::BLOB) TO '{TEMP_DIR_ABSOLUTE}/lance_returning_ingest.bin' (FORMAT BLOB);

query IT
INSERT INTO ns.main.returning_blob VALUES
(7, 'ingest', lance_blob_ingest('file://{TEMP_DIR_ABSOLUTE}/lance_returning_ingest.bin'))
RETURNING id, hex(payload);
----
7	696E676573746564

query T
SELECT hex(payload) FROM ns.main.returning_blob WHERE id = 7;
----
696E676573746564

query IT
UPDATE ns.main.returning_blob
SET payload = lance_blob_ingest('file://{TEMP_DIR_ABSOLUTE}/lance_returning_ingest.bin', 1, 3)
WHERE id = 7 RETURNING id, hex(payload);
----
7	6E6765

query T
SELECT hex(payload) FROM ns.main.returning_blob WHERE id = 7;
----
6E6765

statement ok
DETACH ns;
